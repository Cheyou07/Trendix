# Set these in Render's Environment panel. Never put secrets in frontend variables.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/nifty_scanner
MONGODB_DATABASE=nifty_scanner
CRON_SECRET=replace-with-a-long-random-secret
SNAPSHOT_INDEXES=NIFTY50,NIFTYBANK,NIFTY100,NIFTY200,NIFTY500
# Only needed if hosting the frontend separately; comma-separated exact origins.
CORS_ORIGINS=http://localhost:5173
